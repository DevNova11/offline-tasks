rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account can only see and change its own tasks.
    match /users/{uid}/tasks/{taskId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // The server enforces the optimistic-concurrency contract the app
      // relies on: every write must bump the revision by exactly one, and
      // the document id must match the task's own id.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.id == taskId
        && request.resource.data.rev == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.id == taskId
        && request.resource.data.rev == resource.data.rev + 1;
      allow delete: if false; // deletions are tombstones, never hard deletes
    }
  }
}
